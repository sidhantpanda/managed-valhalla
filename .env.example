# Regions to install when the data volume has none yet (Geofabrik ids, e.g. "us/new-york europe/monaco" or "planet").
VALHALLA_DEFAULT_REGIONS=us/new-york
VALHALLA_THREADS=4
VALHALLA_MAX_CACHE_BYTES=134217728
VALHALLA_MEM_LIMIT=3g
VALHALLA_PORT=8002
VALHALLA_BUILD_THREADS=4
VALHALLA_BUILD_ELEVATION=true
VALHALLA_ADMIN_MEM_LIMIT=3g
VALHALLA_ADMIN_PORT=8003
